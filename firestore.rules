rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người chỉ đọc/ghi document của chính mình: /users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
